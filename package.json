{
  "name": "tarhib",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.0.0",
  "overrides": {
    "@nestjs/swagger@11.4.6": {
      "js-yaml": "5.2.3"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "mobile:employee": "npm run start -w apps/mobile-employee",
    "mobile:employee:web": "npm run web -w apps/mobile-employee",
    "mobile:operations": "npm run start -w apps/mobile-operations",
    "mobile:operations:web": "npm run web -w apps/mobile-operations",
    "mobile:check": "npm run typecheck -w apps/mobile-employee && npm run typecheck -w apps/mobile-operations",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.5",
    "turbo": "^2.10.0"
  },
  "description": "Plateforme de gestion de l'hospitalité corporate (commandes, stock, quotas).",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
