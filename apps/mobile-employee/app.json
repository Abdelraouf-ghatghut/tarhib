{
  "expo": {
    "name": "Tarhib Employee",
    "slug": "tarhib-employee",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "tarhib-employee",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.tarhib.employee",
      "buildNumber": "1",
      "infoPlist": {
        "CFBundleDevelopmentRegion": "ar",
        "CFBundleAllowMixedLocalizations": true,
        "NSUserNotificationsUsageDescription": "Tarhib uses notifications to keep you informed about your orders and bookings."
      }
    },
    "android": {
      "package": "com.tarhib.employee",
      "permissions": ["POST_NOTIFICATIONS", "POST_NOTIFICATIONS"],
      "adaptiveIcon": {
        "backgroundColor": "#F7F8FC"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store",
      "expo-asset",
      [
        "expo-notifications",
        {
          "color": "#4056D6",
          "defaultChannel": "orders"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "943668dd-77f7-481e-a510-78e750503c9d"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/943668dd-77f7-481e-a510-78e750503c9d"
    }
  }
}
